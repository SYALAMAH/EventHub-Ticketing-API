{
  "info": {
    "_postman_id": "78f3aa03-0c49-4bb2-990b-22f5d6b6ba72",
    "name": "Event Ticketing & Venue Booking RESTful Web API",
    "description": "Complete Postman Test Collection for SWC3633/SWC4443 Web API Development Project.\nCovers Authentication, RBAC, Core Resources (Users, Events, Venues, Bookings, Categories), External APIs (QR & PDF), and API Management (Rate Limiting, Pagination, Filtering, Search, Sorting).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "organiser_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_booking_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "created_ticket_code",
      "value": "TKT001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & Security",
      "item": [
        {
          "name": "Login Admin (JWT Generation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"admin_token\", jsonData.data.access_token);",
                  "pm.test(\"Token received\", function () { pm.expect(jsonData.data.access_token).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@2026\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Organiser",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"organiser_token\", jsonData.data.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aina@example.com\",\n  \"password\": \"Aina#Org26\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"customer_token\", jsonData.data.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@example.com\",\n  \"password\": \"Sarah#123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile via Bearer JWT (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Get Profile via API Key (X-API-Key)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "adm_live_key_9876543210abcdef" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02. Events Resource (/events)",
      "item": [
        {
          "name": "List Events (Pagination, Search, Sorting, Filtering)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/events?page=1&limit=10&search=Music&sort_by=event_date&order=asc",
              "host": ["{{base_url}}"],
              "path": ["events"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "Music" },
                { "key": "sort_by", "value": "event_date" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get Single Event by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/events/1", "host": ["{{base_url}}"], "path": ["events", "1"] }
          }
        },
        {
          "name": "Create Event (Organiser / Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organiser_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_name\": \"Cyber Security Hackathon 2026\",\n  \"description\": \"Inter-university cybersecurity and CTF competition.\",\n  \"venue_id\": 1,\n  \"category_id\": 2,\n  \"event_date\": \"2026-11-28\",\n  \"start_time\": \"09:00:00\",\n  \"end_time\": \"18:00:00\",\n  \"ticket_price\": 45.00,\n  \"total_tickets\": 500,\n  \"event_status\": \"published\"\n}"
            },
            "url": { "raw": "{{base_url}}/events", "host": ["{{base_url}}"], "path": ["events"] }
          }
        },
        {
          "name": "Update Event (Organiser / Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organiser_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_price\": 50.00,\n  \"description\": \"Updated prize pool and technical agenda.\"\n}"
            },
            "url": { "raw": "{{base_url}}/events/1", "host": ["{{base_url}}"], "path": ["events", "1"] }
          }
        }
      ]
    },
    {
      "name": "03. Venues Resource (/venues)",
      "item": [
        {
          "name": "List Venues",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/venues?limit=10", "host": ["{{base_url}}"], "path": ["venues"] }
          }
        },
        {
          "name": "Get Venue by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/venues/1", "host": ["{{base_url}}"], "path": ["venues", "1"] }
          }
        },
        {
          "name": "Create Venue (Admin / Organiser)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"venue_name\": \"UPTM Grand Hall\",\n  \"location\": \"Cheras, Kuala Lumpur\",\n  \"capacity\": 1200,\n  \"description\": \"Multipurpose university auditorium with modern AV facilities.\"\n}"
            },
            "url": { "raw": "{{base_url}}/venues", "host": ["{{base_url}}"], "path": ["venues"] }
          }
        }
      ]
    },
    {
      "name": "04. Bookings Resource (/bookings)",
      "item": [
        {
          "name": "List Bookings (Role Filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/bookings", "host": ["{{base_url}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Create Ticket Booking (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"created_booking_id\", jsonData.data.booking_id);",
                  "pm.collectionVariables.set(\"created_ticket_code\", jsonData.data.ticket_code);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": 1,\n  \"quantity\": 2,\n  \"payment_method\": \"card\"\n}"
            },
            "url": { "raw": "{{base_url}}/bookings", "host": ["{{base_url}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Get Booking Details by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/bookings/1", "host": ["{{base_url}}"], "path": ["bookings", "1"] }
          }
        },
        {
          "name": "Cancel Booking (Inventory Refund)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/bookings/5/cancel", "host": ["{{base_url}}"], "path": ["bookings", "5", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "05. Third-Party API Integrations",
      "item": [
        {
          "name": "External QR Code API (Image Format)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/bookings/1/qrcode?format=image", "host": ["{{base_url}}"], "path": ["bookings", "1", "qrcode"], "query": [{ "key": "format", "value": "image" }] }
          }
        },
        {
          "name": "External QR Code API (JSON Metadata)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/bookings/1/qrcode?format=json", "host": ["{{base_url}}"], "path": ["bookings", "1", "qrcode"], "query": [{ "key": "format", "value": "json" }] }
          }
        },
        {
          "name": "PDF Ticket Generation Service (Embedded QR)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{base_url}}/bookings/1/pdf", "host": ["{{base_url}}"], "path": ["bookings", "1", "pdf"] }
          }
        },
        {
          "name": "Ticket Gate Verification Scan Endpoint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"TKT001\"\n}"
            },
            "url": { "raw": "{{base_url}}/bookings/verify-ticket", "host": ["{{base_url}}"], "path": ["bookings", "verify-ticket"] }
          }
        }
      ]
    },
    {
      "name": "06. API Management & Diagnostics",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/stats/health", "host": ["{{base_url}}"], "path": ["stats", "health"] }
          }
        },
        {
          "name": "Dashboard KPI Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/stats/dashboard", "host": ["{{base_url}}"], "path": ["stats", "dashboard"] }
          }
        },
        {
          "name": "External API Telemetry Logs (Audit Trail)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/stats/external-apis", "host": ["{{base_url}}"], "path": ["stats", "external-apis"] }
          }
        }
      ]
    }
  ]
}
